    $method = strtoupper($m[1]);
} elseif (preg_match('/name="_method"\s+value="(PATCH|PUT)"/i', $manage, $m)) {
    $method = strtoupper($m[1]);
}

$f = 'app/Http/Controllers/Admin/Dezerx/AddonsController.php';
$c = file_get_contents($f);

// 1. Return custom login-auth view in show()
if (strpos($c, "admin.dezerx.addons.login-auth") === false) {
    $customShow = "if (\$addon === Addons::LOGIN_AUTH) { return view('admin.dezerx.addons.login-auth', ['key' => \$addon, 'meta' => \$this->meta(\$addon), 'config' => Addons::get(\$addon), 'formMethod' => '{$method}']); } ";
    $c = str_replace(
        "if (\$addon === Addons::DISCORD_BOT) { return redirect()->route('admin.dezerx.discordbot'); }",
        "if (\$addon === Addons::DISCORD_BOT) { return redirect()->route('admin.dezerx.discordbot'); } " . $customShow,
        $c
    );
}

// 2. Preserve existing Client ID / Secret when left blank in update()
if (strpos($c, '_client_secret') === false || strpos($c, 'preserve_secret_patch') === false) {
    $oldLoop = "if (array_key_exists(\$extra, \$data['extras'] ?? [])) { \$extras[\$extra] = (string) (\$data['extras'][\$extra] ?? ''); }";
    $newLoop = "if (array_key_exists(\$extra, \$data['extras'] ?? [])) { /* preserve_secret_patch */ \$val = (string) (\$data['extras'][\$extra] ?? ''); if (\$addon === Addons::LOGIN_AUTH && (str_ends_with(\$extra, '_client_id') || str_ends_with(\$extra, '_client_secret')) && trim(\$val) === '') { continue; } \$extras[\$extra] = \$val; }";
    $c = str_replace($oldLoop, $newLoop, $c);
}

file_put_contents($f, $c);
echo "Patched AddonsController.php (method={$method})\n";
