<?php

namespace Pterodactyl\Http\Controllers\Auth;

use Illuminate\Support\Str;
use Illuminate\Http\Request;
use Pterodactyl\Models\User;
use Illuminate\Support\Facades\Auth;
use Illuminate\Support\Facades\Hash;
use Illuminate\Support\Facades\Http;
use Pterodactyl\Services\Dezerx\Addons;
use Pterodactyl\Http\Controllers\Controller;

class OAuthController extends Controller
{
    private function providerConfig(string $provider): ?array
    {
        $cfg = Addons::get(Addons::LOGIN_AUTH);
        if (!($cfg['enabled'] ?? false)) {
            return null;
        }
        if (($cfg[$provider . '_enabled'] ?? '') !== '1') {
            return null;
        }
        $id = trim((string) ($cfg[$provider . '_client_id'] ?? ''));
        $secret = trim((string) ($cfg[$provider . '_client_secret'] ?? ''));
        if ($id === '' || $secret === '') {
            return null;
        }
        return ['client_id' => $id, 'client_secret' => $secret];
    }

    public function redirect(string $provider)
    {
        $cfg = $this->providerConfig($provider);
        if (!$cfg) {
            return redirect('/auth/login');
        }

        $state = Str::random(40);
        session(['dezerx_oauth_state' => $state]);
        $callback = route('auth.oauth.callback', ['provider' => $provider]);

        $url = match ($provider) {
            'google' => 'https://accounts.google.com/o/oauth2/v2/auth?' . http_build_query([
                'client_id' => $cfg['client_id'],
                'redirect_uri' => $callback,
                'response_type' => 'code',
                'scope' => 'openid email profile',
                'state' => $state,
                'prompt' => 'select_account',
            ]),
            'discord' => 'https://discord.com/api/oauth2/authorize?' . http_build_query([
                'client_id' => $cfg['client_id'],
                'redirect_uri' => $callback,
                'response_type' => 'code',
                'scope' => 'identify email',
                'state' => $state,
            ]),
            'github' => 'https://github.com/login/oauth/authorize?' . http_build_query([
                'client_id' => $cfg['client_id'],
                'redirect_uri' => $callback,
                'scope' => 'read:user user:email',
                'state' => $state,
            ]),
            default => '/auth/login',
        };

        return redirect()->away($url);
    }

    public function callback(Request $request, string $provider)
    {
        $cfg = $this->providerConfig($provider);
        if (!$cfg) {
            return redirect('/auth/login');
        }

        $state = (string) session()->pull('dezerx_oauth_state', '');
        if ($state === '' || !hash_equals($state, (string) $request->query('state', ''))) {
            return redirect('/auth/login');
        }

        $code = (string) $request->query('code', '');
        if ($code === '') {
            return redirect('/auth/login');
        }

        $callback = route('auth.oauth.callback', ['provider' => $provider]);
        $profile = $this->fetchProfile($provider, $cfg, $code, $callback);

        if (!$profile || empty($profile['email'])) {
            return redirect('/auth/login');
        }

        $email = strtolower(trim($profile['email']));
        $user = User::query()->where('email', $email)->first();

        if (!$user) {
            $baseUsername = preg_replace('/[^a-zA-Z0-9._-]/', '', $profile['username'] ?: explode('@', $email)[0]);
            if (strlen($baseUsername) < 3) {
                $baseUsername = 'user' . random_int(100, 999);
            }
            $baseUsername = substr($baseUsername, 0, 24);
            $username = $baseUsername;
            while (User::query()->where('username', $username)->exists()) {
                $username = substr($baseUsername, 0, 19) . '_' . random_int(1000, 9999);
            }

            $user = new User();
            $user->forceFill([
                'uuid' => (string) Str::uuid(),
                'username' => $username,
                'email' => $email,
                'name_first' => substr($profile['first'] ?: $username, 0, 191),
                'name_last' => substr($profile['last'] ?: 'User', 0, 191),
                'password' => Hash::make(Str::random(32)),
                'language' => config('app.locale', 'en'),
                'root_admin' => false,
            ]);
            $user->save();
        }

        Auth::login($user, true);
        $request->session()->regenerate();

        return redirect('/');
    }

    private function fetchProfile(string $provider, array $cfg, string $code, string $callback): ?array
    {
        if ($provider === 'google') {
            $token = Http::asForm()->post('https://oauth2.googleapis.com/token', [
                'client_id' => $cfg['client_id'],
                'client_secret' => $cfg['client_secret'],
                'code' => $code,
                'grant_type' => 'authorization_code',
                'redirect_uri' => $callback,
            ])->json('access_token');

            if (!$token) return null;

            $info = Http::withToken($token)->get('https://www.googleapis.com/oauth2/v2/userinfo')->json();
            return [
                'email' => $info['email'] ?? null,
                'username' => explode('@', (string) ($info['email'] ?? ''))[0],
                'first' => $info['given_name'] ?? ($info['name'] ?? ''),
                'last' => $info['family_name'] ?? 'User',
            ];
        }

        if ($provider === 'discord') {
            $token = Http::asForm()->post('https://discord.com/api/oauth2/token', [
                'client_id' => $cfg['client_id'],
                'client_secret' => $cfg['client_secret'],
                'grant_type' => 'authorization_code',
                'code' => $code,
                'redirect_uri' => $callback,
            ])->json('access_token');

            if (!$token) return null;

            $info = Http::withToken($token)->get('https://discord.com/api/users/@me')->json();
            return [
                'email' => $info['email'] ?? null,
                'username' => $info['username'] ?? '',
                'first' => $info['global_name'] ?? ($info['username'] ?? ''),
                'last' => 'User',
            ];
        }

        if ($provider === 'github') {
            $token = Http::acceptJson()->asForm()->post('https://github.com/login/oauth/access_token', [
                'client_id' => $cfg['client_id'],
                'client_secret' => $cfg['client_secret'],
                'code' => $code,
                'redirect_uri' => $callback,
            ])->json('access_token');

            if (!$token) return null;

            $info = Http::withToken($token)->acceptJson()->get('https://api.github.com/user')->json();
            $email = $info['email'] ?? null;

            if (!$email) {
                $emails = Http::withToken($token)->acceptJson()->get('https://api.github.com/user/emails')->json();
                if (is_array($emails)) {
                    foreach ($emails as $row) {
                        if (($row['primary'] ?? false) && ($row['verified'] ?? false)) {
                            $email = $row['email'] ?? null;
                            break;
                        }
                    }
                    if (!$email && isset($emails[0]['email'])) {
                        $email = $emails[0]['email'];
                    }
                }
            }

            $parts = explode(' ', trim((string) ($info['name'] ?? '')), 2);
            return [
                'email' => $email,
                'username' => $info['login'] ?? '',
                'first' => $parts[0] ?: ($info['login'] ?? ''),
                'last' => $parts[1] ?? 'User',
            ];
        }

        return null;
    }
}
