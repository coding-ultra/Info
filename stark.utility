#!/bin/bash

# কালার কোড
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
WHITE='\033[1;97m'
GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m' # No Color

# Fix Issue ফাংশন
fix_issue() {
    echo -e "\n${GREEN}>>> Running Fix Issue...${NC}\n"
    cd /var/www/pterodactyl || exit

    cat << 'EOF' > theme/app/Services/Dezerx/Appearance.php
<?php

namespace Pterodactyl\Services\Dezerx;

class Appearance
{
    public const SETTING_KEY = 'appearance';

    public const TOKEN_GROUPS = [
