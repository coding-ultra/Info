#!/bin/bash

# কালার কোড
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
WHITE='\033[1;97m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

# স্ক্রিন ক্লিয়ার করা
clear

# SKA & SPARK পাশাপাশি এবং ভরাট (Block) ব্যানার
echo -e "${CYAN}███████ ██   ██  █████      ${WHITE}   ${YELLOW}███████ ██████   █████  ██████  ██   ██${NC}"
echo -e "${CYAN}██      ██  ██  ██   ██     ${WHITE}   ${YELLOW}██      ██   ██ ██   ██ ██   ██ ██  ██ ${NC}"
echo -e "${CYAN}███████ █████   ███████     ${WHITE} & ${YELLOW}███████ ██████  ███████ ██████  █████  ${NC}"
echo -e "${CYAN}     ██ ██  ██  ██   ██     ${WHITE}   ${YELLOW}     ██ ██      ██   ██ ██   ██ ██  ██ ${NC}"
echo -e "${CYAN}███████ ██   ██ ██   ██     ${WHITE}   ${YELLOW}███████ ██      ██   ██ ██   ██ ██   ██${NC}"
echo ""

echo -e "${GREEN}>>> Starting DezerX Theme Setup by SKA & SPARK...${NC}\n"

# থিম ডাউনলোড ও ইনস্টল করা
echo -e "${YELLOW}[1/3] Downloading and extracting theme...${NC}"
wget -q --show-progress https://github.com/coding-ultra/Info2/main/theme.zip
unzip -q -o theme.zip
chmod +x install.sh
bash install.sh

# প্যানেল ডিরেক্টরিতে যাওয়া এবং ডিফল্ট index.php রিস্টোর করা
echo -e "\n${YELLOW}[2/3] Restoring default index.php...${NC}"
cd /var/www/pterodactyl || exit
curl -sL https://raw.githubusercontent.com/pterodactyl/panel/master/public/index.php -o public/index.php > /dev/null 2>&1

# পারমিশন ফিক্স করা
echo -e "${YELLOW}[3/3] Fixing panel permissions...${NC}"
chown -R www-data:www-data /var/www/pterodactyl 2>/dev/null
chown -R nginx:nginx /var/www/pterodactyl 2>/dev/null
find /var/www/pterodactyl -type d -exec chmod 755 {} \;
find /var/www/pterodactyl -type f -exec chmod 644 {} \;
chmod -R 775 storage/* bootstrap/cache/
chown -R www-data:www-data /var/www/pterodactyl/

echo -e "\n${GREEN}>>> Setup Completed Successfully!${NC}"
