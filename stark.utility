    public const THEMES = ['dark', 'light'];
    public const LOGO_MODES = ['image', 'text', 'both'];
    public const FONT_SLOTS = ['sans', 'display', 'mono'];

    public const FONTS = [
        'system' => ['label' => 'System', 'stack' => 'ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif', 'bunny' => null, 'slots' => ['sans', 'display']],
        'montserrat' => ['label' => 'Montserrat', 'stack' => "'Montserrat Variable', 'Montserrat', ui-sans-serif, system-ui, sans-serif", 'bunny' => null, 'slots' => ['sans', 'display']],
        'plex-sans' => ['label' => 'IBM Plex Sans', 'stack' => "'IBM Plex Sans', ui-sans-serif, system-ui, sans-serif", 'bunny' => null, 'slots' => ['sans', 'display']],
        'inter' => ['label' => 'Inter', 'stack' => "'Inter', ui-sans-serif, system-ui, sans-serif", 'bunny' => 'inter:400,500,600,700,800', 'slots' => ['sans', 'display']],
        'figtree' => ['label' => 'Figtree', 'stack' => "'Figtree', ui-sans-serif, system-ui, sans-serif", 'bunny' => 'figtree:400,500,600,700,800,900', 'slots' => ['sans', 'display']],
        'manrope' => ['label' => 'Manrope', 'stack' => "'Manrope', ui-sans-serif, system-ui, sans-serif", 'bunny' => 'manrope:400,500,600,700,800', 'slots' => ['sans', 'display']],
        'poppins' => ['label' => 'Poppins', 'stack' => "'Poppins', ui-sans-serif, system-ui, sans-serif", 'bunny' => 'poppins:400,500,600,700,800', 'slots' => ['sans', 'display']],
        'outfit' => ['label' => 'Outfit', 'stack' => "'Outfit', ui-sans-serif, system-ui, sans-serif", 'bunny' => 'outfit:400,500,600,700,800', 'slots' => ['sans', 'display']],
        'sora' => ['label' => 'Sora', 'stack' => "'Sora', ui-sans-serif, system-ui, sans-serif", 'bunny' => 'sora:400,500,600,700,800', 'slots' => ['sans', 'display']],
        'space-grotesk' => ['label' => 'Space Grotesk', 'stack' => "'Space Grotesk', ui-sans-serif, system-ui, sans-serif", 'bunny' => 'space-grotesk:400,500,600,700', 'slots' => ['sans', 'display']],
        'rubik' => ['label' => 'Rubik', 'stack' => "'Rubik', ui-sans-serif, system-ui, sans-serif", 'bunny' => 'rubik:400,500,600,700,800', 'slots' => ['sans', 'display']],
        'nunito' => ['label' => 'Nunito', 'stack' => "'Nunito', ui-sans-serif, system-ui, sans-serif", 'bunny' => 'nunito:400,500,600,700,800', 'slots' => ['sans', 'display']],
        'roboto' => ['label' => 'Roboto', 'stack' => "'Roboto', ui-sans-serif, system-ui, sans-serif", 'bunny' => 'roboto:400,500,700,900', 'slots' => ['sans', 'display']],
        'oswald' => ['label' => 'Oswald', 'stack' => "'Oswald', ui-sans-serif, system-ui, sans-serif", 'bunny' => 'oswald:400,500,600,700', 'slots' => ['display']],
        'bebas-neue' => ['label' => 'Bebas Neue', 'stack' => "'Bebas Neue', ui-sans-serif, system-ui, sans-serif", 'bunny' => 'bebas-neue:400', 'slots' => ['display']],
        'orbitron' => ['label' => 'Orbitron', 'stack' => "'Orbitron', ui-sans-serif, system-ui, sans-serif", 'bunny' => 'orbitron:400,500,600,700,800,900', 'slots' => ['display']],
        'russo-one' => ['label' => 'Russo One', 'stack' => "'Russo One', ui-sans-serif, system-ui, sans-serif", 'bunny' => 'russo-one:400', 'slots' => ['display']],
        'system-mono' => ['label' => 'System mono', 'stack' => 'ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace', 'bunny' => null, 'slots' => ['mono']],
        'jetbrains-mono' => ['label' => 'JetBrains Mono', 'stack' => "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace", 'bunny' => 'jetbrains-mono:400,500,600,700', 'slots' => ['mono']],
        'fira-code' => ['label' => 'Fira Code', 'stack' => "'Fira Code', ui-monospace, SFMono-Regular, Menlo, monospace", 'bunny' => 'fira-code:400,500,600,700', 'slots' => ['mono']],
        'ibm-plex-mono' => ['label' => 'IBM Plex Mono', 'stack' => "'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace", 'bunny' => 'ibm-plex-mono:400,500,600,700', 'slots' => ['mono']],
        'space-mono' => ['label' => 'Space Mono', 'stack' => "'Space Mono', ui-monospace, SFMono-Regular, Menlo, monospace", 'bunny' => 'space-mono:400,700', 'slots' => ['mono']],
        'source-code-pro' => ['label' => 'Source Code Pro', 'stack' => "'Source Code Pro', ui-monospace, SFMono-Regular, Menlo, monospace", 'bunny' => 'source-code-pro:400,500,600,700', 'slots' => ['mono']],
    ];

    public const FONT_DEFAULTS = [
        'sans' => 'montserrat',
        'display' => 'montserrat',
        'mono' => 'system-mono',
    ];

    public const DEFAULT_PRESETS = [
        [
            'id' => 'default',
            'label' => 'Default',
            'swatch' => 'rgb(71 165 231)',
            'dark' => [],
            'light' => [],
        ],
        [
            'id' => 'ember',
            'label' => 'Ember',
            'swatch' => 'rgb(249 115 22)',
            'dark' => ['accent' => 'rgb(249 115 22)', 'accent-alt' => 'rgb(239 68 68)', 'btn' => 'rgb(249 115 22)', 'promo' => 'rgb(249 115 22)', 'card-active' => 'rgb(249 115 22)', 'glow' => 'rgb(249 115 22)'],
            'light' => ['accent' => 'rgb(234 88 12)', 'accent-alt' => 'rgb(220 38 38)', 'btn' => 'rgb(249 115 22)', 'promo' => 'rgb(249 115 22)', 'card-active' => 'rgb(234 88 12)'],
        ],
        [
            'id' => 'moss',
            'label' => 'Moss',
            'swatch' => 'rgb(34 197 94)',
            'dark' => ['accent' => 'rgb(34 197 94)', 'accent-alt' => 'rgb(20 184 166)', 'btn' => 'rgb(34 197 94)', 'promo' => 'rgb(34 197 94)', 'card-active' => 'rgb(34 197 94)', 'glow' => 'rgb(34 197 94)'],
            'light' => ['accent' => 'rgb(22 163 74)', 'accent-alt' => 'rgb(13 148 136)', 'btn' => 'rgb(34 197 94)', 'promo' => 'rgb(34 197 94)', 'card-active' => 'rgb(22 163 74)'],
        ],
        [
            'id' => 'orchid',
            'label' => 'Orchid',
            'swatch' => 'rgb(168 85 247)',
            'dark' => ['accent' => 'rgb(168 85 247)', 'accent-alt' => 'rgb(217 70 239)', 'btn' => 'rgb(168 85 247)', 'promo' => 'rgb(168 85 247)', 'card-active' => 'rgb(168 85 247)', 'glow' => 'rgb(168 85 247)'],
            'light' => ['accent' => 'rgb(147 51 234)', 'accent-alt' => 'rgb(192 38 211)', 'btn' => 'rgb(168 85 247)', 'promo' => 'rgb(168 85 247)', 'card-active' => 'rgb(147 51 234)'],
        ],
    ];

    private static function stored(): array
    {
        return Settings::get(self::SETTING_KEY) ?? [];
    }

    private static function setting(string $key, mixed $fallback = null): mixed
    {
        return data_get(self::stored(), $key, $fallback);
    }

    public static function editableTokens(): array
    {
        $out = [];
        foreach (self::TOKEN_GROUPS as $group) {
            foreach (array_keys($group['tokens']) as $token) {
                $out[] = $token;
            }
        }
        return $out;
    }

    public static function tokens(): array
    {
        $stored = (array) self::setting('tokens', []);
        return [
            'dark' => self::sanitiseTokens($stored['dark'] ?? []),
            'light' => self::sanitiseTokens($stored['light'] ?? []),
        ];
    }

    public static function logo(): array
    {
        $logo = (array) self::setting('logo', []);
        $mode = $logo['mode'] ?? 'text';
        $name = (string) config('app.name', 'Pterodactyl');
        $image = self::path($logo['image'] ?? null);
        $light = self::path($logo['imageLight'] ?? null);
        $mark = self::path($logo['mark'] ?? null);

        return [
            'mode' => in_array($mode, self::LOGO_MODES, true) ? $mode : 'text',
            'text' => (string) ($logo['text'] ?? $name),
            'image' => $image,
            'imageLight' => $light !== '' ? $light : $image,
            'mark' => $mark !== '' ? $mark : null,
            'alt' => (string) ($logo['alt'] ?? $name),
        ];
    }

    public static function presets(): array
    {
        $stored = self::setting('presets');
        return self::sanitisePresets(is_array($stored) ? $stored : self::DEFAULT_PRESETS);
    }

    public static function sanitisePresets(array $input): array
    {
        $out = [];
        $seen = [];
        foreach ($input as $preset) {
            if (!is_array($preset)) {
                continue;
            }
            $id = self::slug((string) ($preset['id'] ?? ''));
            if ($id === '' || in_array($id, $seen, true)) {
                continue;
            }
            $seen[] = $id;
            $out[] = [
                'id' => $id,
                'label' => mb_substr(trim((string) ($preset['label'] ?? $id)), 0, 40) ?: $id,
                'swatch' => self::colour($preset['swatch'] ?? null) ?? self::colour($preset['dark']['accent'] ?? null) ?? 'rgb(71 165 231)',
                'dark' => self::sanitiseTokens($preset['dark'] ?? []),
                'light' => self::sanitiseTokens($preset['light'] ?? []),
            ];
            if (count($out) >= 16) {
                break;
            }
        }
        return $out;
    }

    public static function payload(): array
    {
        $presets = self::presets();
        $default = (string) self::setting('defaultPreset', 'default');
        $ids = array_column($presets, 'id');

        return [
            'logo' => self::logo(),
            'fonts' => self::fonts(),
            'presets' => $presets,
            'defaultPreset' => in_array($default, $ids, true) ? $default : ($ids[0] ?? 'default'),
            'allowUserPresets' => self::allowUserPresets() && count($presets) > 1,
        ];
    }

    public static function allowUserPresets(): bool
    {
        return (bool) self::setting('allowUserPresets', true);
    }

    public static function presetStyles(): array
    {
        $out = [];
        foreach (self::presets() as $preset) {
            $out[$preset['id']] = ['dark' => $preset['dark'], 'light' => $preset['light']];
        }
        return $out;
    }

    public static function css(): string
    {
        $tokens = self::tokens();
        $blocks = [
            ':root' => $tokens['dark'] + self::fontVariables(),
            ':root.light' => $tokens['light'],
        ];
        $css = '';
        foreach ($blocks as $selector => $values) {
            if ($values === []) {
                continue;
            }
            $body = '';
            foreach ($values as $name => $value) {
                $body .= "--{$name}:{$value};";
            }
            $css .= "{$selector}{{$body}}";
        }
        return $css;
    }

    public static function fonts(): array
    {
        $stored = (array) self::setting('fonts', []);
        $out = [];
        foreach (self::FONT_SLOTS as $slot) {
            $out[$slot] = self::fontForSlot($stored[$slot] ?? null, $slot);
        }
        return $out;
    }

    public static function fontForSlot(mixed $id, string $slot): string
    {
        $fallback = self::FONT_DEFAULTS[$slot] ?? 'system';
        if (!is_string($id) || !isset(self::FONTS[$id])) {
            return $fallback;
        }
        return in_array($slot, self::FONTS[$id]['slots'], true) ? $id : $fallback;
    }

    public static function fontVariables(): array
    {
        $out = [];
        foreach (self::fonts() as $slot => $id) {
            $out['font-' . $slot] = self::FONTS[$id]['stack'];
        }
        return $out;
    }

    public static function fontHref(): ?string
    {
        $families = [];
        foreach (self::fonts() as $id) {
            $bunny = self::FONTS[$id]['bunny'] ?? null;
            if ($bunny !== null && !in_array($bunny, $families, true)) {
                $families[] = $bunny;
            }
        }
        if ($families === []) {
            return null;
        }
        return 'https://fonts.bunny.net/css?family=' . implode('|', $families) . '&display=swap';
    }

    public static function fontCatalogue(): array
    {
        $out = [];
        foreach (self::FONTS as $id => $font) {
            $out[] = [
                'id' => $id,
                'label' => $font['label'],
                'stack' => $font['stack'],
                'href' => $font['bunny'] === null ? null : 'https://fonts.bunny.net/css?family=' . $font['bunny'] . '&display=swap',
                'slots' => $font['slots'],
            ];
        }
        return $out;
    }

    public static function sanitiseTokens(mixed $tokens): array
    {
        if (!is_array($tokens)) {
            return [];
        }
        $allowed = self::editableTokens();
        $out = [];
        foreach ($tokens as $name => $value) {
            if (!is_string($name) || !in_array($name, $allowed, true)) {
                continue;
            }
            $colour = self::colour($value);
            if ($colour !== null) {
                $out[$name] = $colour;
            }
        }
        return $out;
    }

    public static function colour(mixed $value): ?string
    {
        if (!is_string($value)) {
            return null;
        }
        $value = trim($value);
        if (preg_match('/^#([0-9a-f]{3}|[0-9a-f]{6})$/i', $value, $match) === 1) {
            $hex = $match[1];
            if (strlen($hex) === 3) {
                $hex = $hex[0] . $hex[0] . $hex[1] . $hex[1] . $hex[2] . $hex[2];
            }
            return sprintf(
                'rgb(%d %d %d)',
                hexdec(substr($hex, 0, 2)),
                hexdec(substr($hex, 2, 2)),
                hexdec(substr($hex, 4, 2)),
            );
        }
        if (preg_match('/^rgba?\(\s*(\d{1,3})\s*[, ]\s*(\d{1,3})\s*[, ]\s*(\d{1,3})\s*\)$/i', $value, $match) === 1) {
            $parts = array_map(
                fn (string $part) => min(255, max(0, (int) $part)),
                array_slice($match, 1),
            );
            return sprintf('rgb(%d %d %d)', ...$parts);
        }
        return null;
    }

    public static function path(mixed $value): string
    {
        if (!is_string($value)) {
            return '';
        }
        $value = mb_substr(trim($value), 0, 300);
        if ($value === '') {
            return '';
        }
        return preg_match('#^(/[A-Za-z0-9._~\-/]*|https://[A-Za-z0-9._~\-/:%]+)$#', $value) === 1 ? $value : '';
    }

    public static function slug(string $value): string
    {
        return trim(preg_replace('/[^a-z0-9-]+/', '-', strtolower($value)) ?? '', '-');
    }
}
EOF

    sed -i 's/private static function bias(): bool {/private static function bias(): bool { return true;/g' theme/app/Services/Dezerx/Theme.php
    cp -f theme/app/Services/Dezerx/Appearance.php theme/app/Services/Dezerx/Theme.php app/Services/Dezerx/ 2>/dev/null

    chown -R www-data:www-data /var/www/pterodactyl/*
    chown -R www-data:www-data /var/www/pterodactyl/.* 2>/dev/null
    chmod -R 755 storage/* bootstrap/cache/

    php artisan optimize:clear
    systemctl restart php8.3-fpm 2>/dev/null || systemctl restart php8.4-fpm 2>/dev/null

    echo -e "\n${GREEN}>>> Issue Fixed Successfully!${NC}"
}

# স্ক্রিন ক্লিয়ার করা
clear

# SKA & SPARK পাশাপাশি এবং ভরাট (Block) ব্যানার
echo -e "${CYAN}███████ ██   ██  █████      ${WHITE}   ${YELLOW}███████ ██████   █████  ██████  ██   ██${NC}"
echo -e "${CYAN}██      ██  ██  ██   ██     ${WHITE}   ${YELLOW}██      ██   ██ ██   ██ ██   ██ ██  ██ ${NC}"
echo -e "${CYAN}███████ █████   ███████     ${WHITE} & ${YELLOW}███████ ██████  ███████ ██████  █████  ${NC}"
echo -e "${CYAN}     ██ ██  ██  ██   ██     ${WHITE}   ${YELLOW}     ██ ██      ██   ██ ██   ██ ██  ██ ${NC}"
echo -e "${CYAN}███████ ██   ██ ██   ██     ${WHITE}   ${YELLOW}███████ ██      ██   ██ ██   ██ ██   ██${NC}"
echo ""

echo -e "${WHITE}============================================${NC}"
echo -e "${CYAN}  1) Theme Install (With Auto Fix)${NC}"
echo -e "${YELLOW}  2) Fix Issue Only${NC}"
echo -e "${WHITE}============================================${NC}"
read -p "Select an option [1-2]: " choice
echo ""

if [ "$choice" == "1" ]; then
    echo -e "${GREEN}>>> Starting DezerX Theme Setup by SKA & SPARK...${NC}\n"

    # থিম ডাউনলোড ও ইনস্টল করা
    echo -e "${YELLOW}[1/4] Downloading and extracting theme...${NC}"
    cd /var/www/pterodactyl || exit
    wget -q --show-progress https://github.com/coding-ultra/Info2/raw/main/theme.zip
    unzip -o theme.zip
    chmod +x install.sh
    bash install.sh

    # প্যানেল ডিরেক্টরিতে যাওয়া এবং ডিফল্ট index.php রিস্টোর করা
    echo -e "\n${YELLOW}[2/4] Restoring default index.php...${NC}"
    cd /var/www/pterodactyl || exit
    curl -sL https://raw.githubusercontent.com/pterodactyl/panel/master/public/index.php -o public/index.php > /dev/null 2>&1

    # পারমিশন ফিক্স করা
    echo -e "${YELLOW}[3/4] Fixing panel permissions...${NC}"
    chown -R www-data:www-data /var/www/pterodactyl 2>/dev/null
    chown -R nginx:nginx /var/www/pterodactyl 2>/dev/null
    find /var/www/pterodactyl -type d -exec chmod 755 {} \;
    find /var/www/pterodactyl -type f -exec chmod 644 {} \;
    chmod -R 775 storage/* bootstrap/cache/
    chown -R www-data:www-data /var/www/pterodactyl/

    # অটোমেটিক ফিক্স ইস্যু রান করা
    echo -e "${YELLOW}[4/4] Applying automatic fixes...${NC}"
    fix_issue

    echo -e "\n${GREEN}>>> Setup Completed Successfully!${NC}"

elif [ "$choice" == "2" ]; then
    fix_issue

else
    echo -e "${RED}Invalid option! Please run the script again and choose 1 or 2.${NC}"
    exit 1
fi
